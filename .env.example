# 环境变量示例（复制为 .env 后修改）

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 主加密密钥（用于 AES-GCM 加密 NAS 访问 Token 与密码凭据，生产环境请务必更换为高强度随机字符串）
APP_ENCRYPTION_SECRET=panhub-taoge-nas-secret-key-2026

# 超级管理员首次自举初始化邀请码（可选，首次注册后即可在 /admin 界面生成一次性邀请码）
ADMIN_BOOTSTRAP_CODE=taoge-admin-2026

# 可选：显式声明前置了可信反向代理（Cloudflare / nginx 等，值为 1）。
# 声明后才信任 CF-Connecting-IP / X-Forwarded-For 头解析客户端 IP（限流用）；
# 默认不信任任何代理头，Docker 直连场景无需配置。
# TRUST_PROXY=1
